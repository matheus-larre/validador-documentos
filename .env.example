# Copie este arquivo para .env e preencha os valores.
# O .env NÃO vai para o Git (está no .gitignore). Nunca coloque chaves reais aqui.

# Pasta de idiomas do Tesseract (opcional no Windows; padrão: C:/Program Files/Tesseract-OCR/tessdata)
TESSDATA_PATH=

# Chave da API do Google Gemini (usada na etapa de extração com IA)
GEMINI_API_KEY=

# Modelo do Gemini (opcional; padrão: gemini-2.5-flash)
GEMINI_MODEL=

# Banco de dados PostgreSQL (opcionais; os padrões batem com o container local)
DB_URL=jdbc:postgresql://localhost:5432/validador
DB_USER=validador
DB_PASSWORD=validador
