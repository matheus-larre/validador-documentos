# Copie este arquivo para .env e preencha os valores.
# O .env NÃO vai para o Git (está no .gitignore). Nunca coloque chaves reais aqui.

# Pasta de idiomas do Tesseract (opcional no Windows; padrão: C:/Program Files/Tesseract-OCR/tessdata)
TESSDATA_PATH=

# Chave da API do Google Gemini (usada na etapa de extração com IA)
GEMINI_API_KEY=
